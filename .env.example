# ---- Gemini ----------------------------------------------------------------
# Free AI Studio key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Purpose-built Live transcription model (listens only, never answers).
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
# Comma-separated fallbacks tried if the primary model fails to connect.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-live-preview,gemini-3.8-live
# The Live websocket endpoint requires v1beta (the SDK default of v1 returns 404).
GEMINI_API_VERSION=v1beta

# ---- Database --------------------------------------------------------------
# For docker-compose, host "db" is the postgres service name.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/transcriptions
# For running the app directly on your machine, use localhost instead:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/transcriptions

# ---- App -------------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated origins, or * for any (default). Set to your real domain in prod.
ALLOWED_ORIGINS=*

# ---- Limits (protect the free Gemini quota) --------------------------------
MAX_SESSION_SECONDS=900
MAX_CONCURRENT_SESSIONS=4
MAX_TRANSCRIPT_CHARS=50000
